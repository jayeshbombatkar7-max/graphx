/* =========================
   KEYBOARD
========================= */

function insertKey(value){

    if(!activeInput){

        addExpression(value);

        const inputs=
            document.querySelectorAll(
                ".exprInput"
            );

        activeInput=
            inputs[inputs.length-1];

        activeInput.focus();

        return;
    }

    const start=
        activeInput.selectionStart;

    const end=
        activeInput.selectionEnd;

    const text=activeInput.value;

    activeInput.value=
        text.substring(0,start)
        +value
        +text.substring(end);

    activeInput.focus();

    activeInput.selectionStart=
    activeInput.selectionEnd=
        start+value.length;

    activeInput.dispatchEvent(
        new Event("input")
    );
}


function backspace(){

    if(!activeInput)return;

    const start=
        activeInput.selectionStart;

    const end=
        activeInput.selectionEnd;

    if(start===end && start>0){

        activeInput.value=
            activeInput.value.substring(0,start-1)
            +activeInput.value.substring(end);

        activeInput.selectionStart=
        activeInput.selectionEnd=
            start-1;

    }else{

        activeInput.value=
            activeInput.value.substring(0,start)
            +activeInput.value.substring(end);

        activeInput.selectionStart=
        activeInput.selectionEnd=
            start;
    }

    activeInput.dispatchEvent(
        new Event("input")
    );
}


/* =========================
   TABLE
========================= */

function openTable(){

    const modal=
        document.getElementById(
            "tableModal"
        );

    const table=
        document.getElementById(
            "tableContent"
        );

    if(expressions.length===0){

        table.innerHTML=
            "<p>Add an expression first.</p>";

        modal.classList.add("show");

        return;
    }

    let html="<table><thead><tr><th>x</th>";

    expressions.forEach((e,i)=>{

        html+=
            `<th>f${i+1}(x)</th>`;
    });

    html+="</tr></thead><tbody>";

    for(let x=-5;x<=5;x+=.5){

        html+=`<tr><td>${x}</td>`;

        expressions.forEach(exp=>{

            const y=
                evaluateExpression(
                    exp.value,
                    x
                );

            html+=
                `<td>${
                    Number.isFinite(y)
                    ?Number(y.toFixed(5))
                    :"—"
                }</td>`;

        });

        html+="</tr>";
    }

    html+="</tbody></table>";

    table.innerHTML=html;

    modal.classList.add("show");
}


function closeTable(){

    document
    .getElementById("tableModal")
    .classList.remove("show");
}


/* =========================
   SLIDERS
========================= */

function addSlider(){

    const name=
        prompt(
            "Variable name:",
            "a"
        );

    if(!name)return;

    const clean=
        name.trim().toLowerCase();

    if(!/^[a-z]$/.test(clean)){

        alert(
            "Use one letter: a, b or c"
        );

        return;
    }

    const value=
        Number(
            prompt(
                "Starting value:",
                sliders[clean] || 1
            )
        );

    if(!Number.isFinite(value))return;

    sliders[clean]=value;

    renderSliders();

    draw();
}


function renderSliders(){

    const box=
        document.getElementById(
            "sliders"
        );

    box.innerHTML="";

    Object.keys(sliders).forEach(name=>{

        const row=
            document.createElement("div");

        row.className="sliderRow";

        row.innerHTML=`

            <b>${name}</b>

            <input
                type="range"
                min="-10"
                max="10"
                step="0.1"
                value="${sliders[name]}"
                oninput="
                    sliders['${name}']=Number(this.value);
                    this.nextElementSibling.textContent=this.value;
                    draw();
                    save();
                "
            >

            <span class="sliderValue">
                ${sliders[name]}
            </span>

        `;

        box.appendChild(row);

    });
}


/* =========================
   DERIVATIVE
========================= */

function derivative(){

    if(!expressions.length){

        alert("Add an equation first.");

        return;
    }

    const exp=
        expressions[
            expressions.length-1
        ].value;

    const h=0.0001;

    const derivativeFunction=
        x=>{

            const f1=
                evaluateExpression(
                    exp,x+h
                );

            const f2=
                evaluateExpression(
                    exp,x-h
                );

            return (f1-f2)/(2*h);

        };

    expressions.push({

        id:Date.now()+Math.random(),

        value:"Derivative of: "+exp,

        color:
            colors[
                expressions.length
                %colors.length
            ],

        customFunction:
            derivativeFunction

    });

    /*
      Custom derivative expression is handled
      separately by replacing the text below.
    */

    expressions[
        expressions.length-1
    ].value=
        `derivative(${cleanExpression(exp)})`;

    renderExpressions();

    draw();

    alert(
        "Derivative added numerically.\n"+
        "The graph uses central-difference approximation."
    );
}


/* =========================
   INTEGRAL
========================= */

function integral(){

    if(!expressions.length){

        alert("Add an equation first.");

        return;
    }

    const exp=
        expressions[
            expressions.length-1
        ].value;

    const a=
        Number(
            prompt(
                "Lower limit:",
                0
            )
        );

    const b=
        Number(
            prompt(
                "Upper limit:",
                1
            )
        );

    if(
        !Number.isFinite(a) ||
        !Number.isFinite(b)
    )return;

    const n=1000;

    let sum=0;

    const h=(b-a)/n;

    for(let i=0;i<=n;i++){

        const x=a+i*h;

        const y=
            evaluateExpression(
                exp,x
            );

        if(!Number.isFinite(y))continue;

        const weight=
            i===0||i===n
            ?1
            :(i%2===0?2:4);

        sum+=weight*y;
    }

    const result=
        sum*h/3;

    alert(
        `Numerical integral of\n${exp}\n\n`+
        `[${a}, ${b}] = ${result}`
    );
}


