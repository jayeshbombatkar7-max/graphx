    "keydown",
    e=>{

        if(
            e.ctrlKey &&
            e.key==="Enter"
        ){

            draw();

        }

        if(e.key==="Escape"){

            closeTable();

        }

    }
);


/* =========================
   START
========================= */

load();

resize();

