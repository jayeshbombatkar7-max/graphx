   FULLSCREEN
========================= */

function fullscreen(){

    if(!document.fullscreenElement){

        document.documentElement
        .requestFullscreen();

    }else{

        document.exitFullscreen();

    }
}


/* =========================
   SAVE
========================= */

function save(){

    localStorage.setItem(
        "graphpro-expressions",
        JSON.stringify(expressions)
    );

    localStorage.setItem(
        "graphpro-sliders",
        JSON.stringify(sliders)
    );
}


function load(){

    try{

        const saved=
            localStorage.getItem(
                "graphpro-expressions"
            );

        if(saved){

            expressions=
                JSON.parse(saved);

            renderExpressions();

        }else{

            addExpression("y = x^2");

            addExpression("y = sin(x)");

        }

        const savedSliders=
            localStorage.getItem(
                "graphpro-sliders"
            );

        if(savedSliders){

            sliders=
                JSON.parse(savedSliders);

        }

        renderSliders();

    }catch{

        expressions=[];

        addExpression("y = x^2");

    }

    const theme=
        localStorage.getItem(
            "graphpro-theme"
        );

    if(theme==="light"){

        document.body.classList.add(
            "light"
        );
    }
}


